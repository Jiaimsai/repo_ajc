#include "xil_types.h"
#include "xil_cache.h"

#define FB_ADDR 0x01000000
#define WIDTH   640
#define HEIGHT  480

int main()
{
	u8 *fb = (u8 *)0x01000000;

	for (int y = 0; y < 480; y++) {
	    for (int x = 0; x < 640; x++) {

	        u8 v = (x * 255) / 639;

	        *fb++ = v;   // R
	        *fb++ = v;   // G
	        *fb++ = v;   // B
	    }
	}

	Xil_DCacheFlushRange(0x01000000, 640 * 480 * 3);

    while(1);
}
