#include "xparameters.h"
#include "xil_io.h"

#define TPG_BASE XPAR_V_TPG_0_S_AXI_CTRL_BASEADDR

#define TPG_CTRL       0x00
#define TPG_HEIGHT     0x10
#define TPG_WIDTH      0x18
#define TPG_PATTERN    0x20
#define TPG_OVERLAY    0x28
#define TPG_MASK       0x30
#define TPG_COLOR_FMT  0x40

#define WIDTH          640
#define HEIGHT         480

int main()
{
    Xil_Out32(TPG_BASE + TPG_HEIGHT, HEIGHT);
    Xil_Out32(TPG_BASE + TPG_WIDTH, WIDTH);

    Xil_Out32(TPG_BASE + TPG_COLOR_FMT, 0x00);

    Xil_Out32(TPG_BASE + TPG_OVERLAY, 0x00);
    Xil_Out32(TPG_BASE + TPG_MASK, 0x00);

    Xil_Out32(TPG_BASE + TPG_PATTERN, 0x09);

    Xil_Out32(TPG_BASE + TPG_CTRL, 0x81);

    while (1)
    {
    }

    return 0;
}
