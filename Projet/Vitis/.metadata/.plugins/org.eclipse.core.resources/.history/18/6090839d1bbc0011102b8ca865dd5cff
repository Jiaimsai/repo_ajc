#include "xil_io.h"
#include "xil_cache.h"
#include "sleep.h"

#define VDMA_BASE_ADDR       0x43000000U
#define FRAMEBUFFER_ADDR     0x01000000U

#define WIDTH                640
#define HEIGHT               480
#define BYTES_PER_PIXEL      3
#define STRIDE               (WIDTH * BYTES_PER_PIXEL)
#define FRAME_SIZE           (STRIDE * HEIGHT)

#define MM2S_DMACR           0x00
#define MM2S_DMASR           0x04
#define MM2S_VSIZE           0x50
#define MM2S_HSIZE           0x54
#define MM2S_FRMDLY_STRIDE   0x58
#define MM2S_START_ADDR1     0x5C

#define GENERATE_TEST_PATTERN 1

static void generate_test_pattern(void)
{
	u8 *fb = (u8 *)0x01000000;

	for (int y = 0; y < 480; y++) {
	    for (int x = 0; x < 640; x++) {

	        int niveau = x / 40;        // 0 à 15
	        u8 v = niveau * 0x11;       // 00,11,22,...,FF

	        *fb++ = v;   // R
	        *fb++ = v;   // G
	        *fb++ = v;   // B
	    }
	}

	Xil_DCacheFlushRange(0x01000000, 640 * 480 * 3);
}

static void reset_vdma(void)
{
    Xil_Out32(VDMA_BASE_ADDR + MM2S_DMACR, 0x00000004);

    while (Xil_In32(VDMA_BASE_ADDR + MM2S_DMACR) & 0x00000004)
    {
    }
}

static void start_vdma(void)
{
    reset_vdma();

    Xil_Out32(VDMA_BASE_ADDR + MM2S_DMACR, 0x00000001);

    Xil_Out32(
        VDMA_BASE_ADDR + MM2S_START_ADDR1,
        FRAMEBUFFER_ADDR
    );

    Xil_Out32(
        VDMA_BASE_ADDR + MM2S_FRMDLY_STRIDE,
        STRIDE
    );

    Xil_Out32(
        VDMA_BASE_ADDR + MM2S_HSIZE,
        STRIDE
    );

    Xil_Out32(
        VDMA_BASE_ADDR + MM2S_VSIZE,
        HEIGHT
    );

    usleep(100000);
}

int main()
{
#if GENERATE_TEST_PATTERN
    generate_test_pattern();
#endif

    start_vdma();

    while (1)
    {
    }

    return 0;
}

