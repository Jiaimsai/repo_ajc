#include "xparameters.h"
#include "xil_io.h"
#include "xil_printf.h"
#include "xv_tpg.h"
#include "sleep.h"

#define VDMA_BASE_ADDR       0x43000000U
#define FRAMEBUFFER_ADDR     0x01000000U

#define WIDTH                640
#define HEIGHT               480
#define STRIDE               (WIDTH * 3)

#define MM2S_DMACR           0x00
#define MM2S_DMASR           0x04
#define MM2S_VSIZE           0x50
#define MM2S_HSIZE           0x54
#define MM2S_STRIDE          0x58
#define MM2S_START_ADDR      0x5C

static XV_tpg Tpg;

static void vdma_start(void)
{
    Xil_Out32(VDMA_BASE_ADDR + MM2S_DMACR, 0x00000004);

    while (Xil_In32(VDMA_BASE_ADDR + MM2S_DMACR) & 0x00000004)
    {
    }

    Xil_Out32(VDMA_BASE_ADDR + MM2S_DMACR, 0x00010001);

    Xil_Out32(
        VDMA_BASE_ADDR + MM2S_START_ADDR,
        FRAMEBUFFER_ADDR
    );

    Xil_Out32(
        VDMA_BASE_ADDR + MM2S_STRIDE,
        STRIDE
    );

    Xil_Out32(
        VDMA_BASE_ADDR + MM2S_HSIZE,
        STRIDE
    );

    Xil_Out32(
        VDMA_BASE_ADDR + MM2S_VSIZE,
        HEIGHT
    );
}

static int tpg_init(void)
{
    XV_tpg_Config *Cfg;

    Cfg = XV_tpg_LookupConfig(XPAR_V_TPG_0_DEVICE_ID);

    if (Cfg == NULL)
        return -1;

    if (XV_tpg_CfgInitialize(&Tpg, Cfg, Cfg->BaseAddress) != XST_SUCCESS)
        return -1;

    XV_tpg_Set_height(&Tpg, HEIGHT);
    XV_tpg_Set_width(&Tpg, WIDTH);

    XV_tpg_Set_colorFormat(&Tpg, 0);

    XV_tpg_Set_ovrlayId(&Tpg, 0);

    return 0;
}

static void tpg_stop(void)
{
    XV_tpg_DisableAutoRestart(&Tpg);

    while (!XV_tpg_IsIdle(&Tpg))
    {
    }
}

static void mode_tpg(void)
{
    tpg_stop();

    XV_tpg_Set_height(&Tpg, HEIGHT);
    XV_tpg_Set_width(&Tpg, WIDTH);

    XV_tpg_Set_colorFormat(&Tpg, 0);

    XV_tpg_Set_enableInput(&Tpg, 0);

    XV_tpg_Set_bckgndId(
        &Tpg,
        XTPG_BKGND_COLOR_BARS
    );

    XV_tpg_Set_ovrlayId(&Tpg, 0);

    XV_tpg_EnableAutoRestart(&Tpg);
    XV_tpg_Start(&Tpg);
}

static void mode_ddr(void)
{
    tpg_stop();

    XV_tpg_Set_height(&Tpg, HEIGHT);
    XV_tpg_Set_width(&Tpg, WIDTH);

    XV_tpg_Set_colorFormat(&Tpg, 0);

    XV_tpg_Set_bckgndId(
        &Tpg,
        XTPG_BKGND_COLOR_BARS
    );

    XV_tpg_Set_ovrlayId(&Tpg, 0);

    XV_tpg_Set_enableInput(&Tpg, 1);

    XV_tpg_Set_passthruStartX(&Tpg, 0);
    XV_tpg_Set_passthruStartY(&Tpg, 0);

    XV_tpg_Set_passthruEndX(&Tpg, WIDTH);
    XV_tpg_Set_passthruEndY(&Tpg, HEIGHT);

    XV_tpg_EnableAutoRestart(&Tpg);
    XV_tpg_Start(&Tpg);
}

int main(void)
{
    if (tpg_init() != 0)
    {
        return -1;
    }

    vdma_start();

    mode_tpg();

    while (1)
    {
        char c = inbyte();

        if ((c == 't') || (c == 'T'))
        {
            mode_tpg();
        }

        if ((c == 'i') || (c == 'I'))
        {
            mode_ddr();
        }
    }

    return 0;
}
