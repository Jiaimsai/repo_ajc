<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="dma_test_59"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
dma_test_59
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="dma_test_59">
        <sdx:configuration sdx:name="dma_test_59"
                           sdx:displayName="dma_test_59"
                           sdx:defaultProcessorGroup="standalone_domain"
                           sdx:runtimes="cpp">
            <sdx:description>dma_test_59</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="dma_test_59/boot/dma_test_59.bif"
                            sdx:readme="dma_test_59/boot/generic.readme"
                            sdx:qemuArguments="dma_test_59/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_domain"
                            sdx:bif="dma_test_59/boot/dma_test_59.bif"
                            sdx:readme="dma_test_59/boot/generic.readme"
                            sdx:qemuArguments="dma_test_59/standalone_domain/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone on ps7_cortexa9_0"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="dma_test_59/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="dma_test_59/standalone_domain/bspinclude/include"
                        sdx:bspConfig="dma_test_59/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
